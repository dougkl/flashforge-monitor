<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>flashforge-monitor</AssemblyName>
    <RootNamespace>FlashforgeMonitor</RootNamespace>
    <Version>0.1.0</Version>
    <!-- Single-file, self-contained publish (used by the release workflow) -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="appsettings.local.json" CopyToPublishDirectory="Never" />
    <Content Remove="data/**" />
    <None Remove="data/**" />
  </ItemGroup>

</Project>
